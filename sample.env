# Better Auth is mounted at /api/v1/auth. Use a cryptographically random value.
BETTER_AUTH_URL=http://localhost:8000/api/v1/auth
BETTER_AUTH_SECRET=

# Better Auth validates its reset token, then redirects the browser here with
# `?token=<token>`. This origin is added to Better Auth trusted origins.
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# URL of the delivery service that sends the generated passwordResetURL to the
# user. It receives a JSON POST with { type, email, passwordResetURL }.
PASSWORD_RESET_DELIVERY_URL=
